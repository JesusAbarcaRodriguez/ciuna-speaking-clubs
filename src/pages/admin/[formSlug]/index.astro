---
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import AdminPanel from '../../../components/admin/AdminPanel';
import { db } from '../../../db/client';
import { forms, questions, responses } from '../../../db/schema';
import { eq, desc } from 'drizzle-orm';
import { getImage } from 'astro:assets';
import logoCiuna from '../../../images/logo-ciuna.png';

export const prerender = false;

const { formSlug } = Astro.params;
const [form] = await db.select().from(forms).where(eq(forms.slug, formSlug!));

if (!form) {
  return new Response(null, { status: 404 });
}

const questionRows = await db
  .select()
  .from(questions)
  .where(eq(questions.formId, form.id))
  .orderBy(questions.order);
const responseRows = await db
  .select()
  .from(responses)
  .where(eq(responses.formId, form.id))
  .orderBy(desc(responses.submittedAt));

const publicUrl = new URL(`/${form.slug}`, Astro.url).toString();
const logo = await getImage({ src: logoCiuna, width: 80, height: 80 });
---

<Layout titulo={`Editar ${form.name} - CI-UNA`}>
  <div class="min-h-screen bg-[#f0ead6] py-8 px-4 flex flex-col">
    <div class="max-w-[800px] mx-auto w-full flex-1">
      <AdminPanel
        client:load
        formSlug={form.slug}
        formName={form.name}
        initialMeta={{
          title: form.title,
          description: form.description,
          acceptingResponses: form.acceptingResponses,
        }}
        initialQuestions={questionRows}
        initialResponses={responseRows.map((r) => ({
          id: r.id,
          submittedAt: r.submittedAt.toISOString(),
          answers: r.answers,
        }))}
        publicUrl={publicUrl}
        logoUrl={logo.src}
      />
    </div>
    <Footer />
  </div>
</Layout>
