---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoCiuna from '../../images/logo-ciuna.png';
export const prerender = false;
---

<Layout titulo="Admin - Speaking Clubs">
  <div class="min-h-screen bg-[#f0ead6] flex items-center justify-center px-4">
    <div class="w-full max-w-sm space-y-4">
      <div class="flex justify-center">
        <Image src={logoCiuna} alt="Centro de Idiomas - Universidad Nacional" class="w-28 h-28 rounded-full" />
      </div>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8">
        <h1 class="text-xl font-semibold text-gray-800 mb-6">Acceso administrador</h1>
        <form id="login-form" class="space-y-4">
          <div>
            <label for="email" class="block text-sm text-gray-700 mb-1">Correo</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="w-full border border-gray-300 rounded px-3 py-2 outline-none focus:border-brand"
            />
          </div>
          <div>
            <label for="password" class="block text-sm text-gray-700 mb-1">Contraseña</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              class="w-full border border-gray-300 rounded px-3 py-2 outline-none focus:border-brand"
            />
          </div>
          <p id="login-error" class="hidden text-red-600 text-sm"></p>
          <button
            type="submit"
            class="w-full bg-brand hover:bg-indigo-600 text-white font-medium rounded-md px-4 py-2 transition-colors"
          >
            Ingresar
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorNote = document.getElementById('login-error') as HTMLParagraphElement;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorNote.classList.add('hidden');

    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;

    const res = await fetch('/api/admin/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password }),
    });

    if (res.ok) {
      window.location.href = '/admin';
      return;
    }

    const data = await res.json().catch(() => ({}));
    errorNote.textContent = data.error || 'Error al iniciar sesión.';
    errorNote.classList.remove('hidden');
  });
</script>
