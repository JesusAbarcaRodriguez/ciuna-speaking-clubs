---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import logoBanner from '../images/logo.png';
import levelsDiagram from '../images/levels.png';
import { db } from '../db/client';
import { formMeta, questions } from '../db/schema';
import { eq, sql } from 'drizzle-orm';

export const prerender = false;

// Debe coincidir con la capacidad definida en sql/001_club_capacity_trigger.sql
const CLUB_CAPACITY = 17;

const [meta] = await db.select().from(formMeta).where(eq(formMeta.id, 1));
const questionRows = await db.select().from(questions).orderBy(questions.order);

const radioQuestion = questionRows.find((q) => q.type === 'radio');
const clubCounts: Record<string, number> = {};
if (radioQuestion) {
  const counts = await db.execute<{ club: string; n: number }>(sql`
    SELECT answers ->> ${radioQuestion.label} AS club, count(*)::int AS n
    FROM responses
    GROUP BY club
  `);
  for (const row of counts) {
    if (row.club) clubCounts[row.club] = Number(row.n);
  }
}

const images: Record<string, ImageMetadata> = {
  levels: levelsDiagram,
};

function renderDescription(text: string) {
  return text.split(/\*\*(.+?)\*\*/g).map((part, i) => (i % 2 === 1 ? { bold: part } : part));
}

const descriptionParts = meta ? renderDescription(meta.description) : [];
---

<Layout titulo="Speaking Clubs Registration - CI-UNA">
  <div class="min-h-screen bg-[#f0ead6] py-8 px-4">
    <form id="registration-form" class="max-w-[700px] mx-auto space-y-4">
      <!-- Banner -->
      <div class="rounded-lg overflow-hidden">
        <Image src={logoBanner} alt="Speaking Clubs Registration - Centro de Idiomas - Universidad Nacional" class="w-full h-auto" />
      </div>

      <!-- Title card -->
      <div class="bg-white rounded-lg shadow-sm border-t-8 border-brand overflow-hidden">
        <div class="p-6 sm:p-8">
          <h1 class="text-3xl text-gray-800 mb-4">{meta?.title}</h1>
          <p class="text-sm text-gray-700 leading-relaxed">
            {descriptionParts.map((part) =>
              typeof part === 'string' ? part : <strong>{part.bold}</strong>
            )}
          </p>
        </div>
        {meta && !meta.acceptingResponses ? (
          <div class="border-t border-gray-200 px-6 sm:px-8 py-4 bg-amber-50">
            <p class="text-gray-700 text-sm">Este formulario ya no acepta respuestas.</p>
          </div>
        ) : (
          <div class="border-t border-gray-200 px-6 sm:px-8 py-3">
            <p class="text-red-600 text-sm">* Indica que la pregunta es obligatoria</p>
          </div>
        )}
      </div>

      {meta?.acceptingResponses && questionRows.map((q) => {
        const fieldId = `q-${q.id}`;
        if (q.type === 'info') {
          const image = q.imageKey ? images[q.imageKey] : undefined;
          return (
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 sm:p-8">
              <h2 class="font-bold text-gray-800 mb-4">{q.label}</h2>
              {image && (
                <Image src={image} alt={q.label} class="block w-full h-auto max-w-lg mx-auto" />
              )}
            </div>
          );
        }

        if (q.type === 'select') {
          return (
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 sm:p-8">
              <label class="block text-gray-800 mb-4" for={fieldId}>
                {q.label} {q.required && <span class="text-red-600">*</span>}
              </label>
              <select
                id={fieldId}
                name={q.label}
                required={q.required}
                class="w-full border border-gray-300 rounded px-3 py-2 text-gray-700 bg-white outline-none focus:border-brand"
              >
                <option value="" selected disabled>Elegir</option>
                {(q.options || []).map((opt) => <option value={opt}>{opt}</option>)}
              </select>
            </div>
          );
        }

        if (q.type === 'radio') {
          const availableOptions = (q.options || []).filter(
            (opt) => (clubCounts[opt] || 0) < CLUB_CAPACITY,
          );
          return (
            <div role="group" aria-label={q.label} class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 sm:p-8">
              <p class="font-bold text-gray-800 mb-4">
                {q.label} {q.required && <span class="text-red-600">*</span>}
              </p>
              {availableOptions.length === 0 ? (
                <p class="text-gray-500 text-sm">
                  Todos los horarios alcanzaron el cupo máximo por el momento.
                </p>
              ) : (
                <div class="space-y-4">
                  {availableOptions.map((opt) => (
                    <label class="flex items-center gap-3 cursor-pointer">
                      <input
                        type="radio"
                        name={q.label}
                        value={opt}
                        required={q.required}
                        class="w-5 h-5 accent-brand"
                      />
                      <span class="text-gray-800">{opt}</span>
                    </label>
                  ))}
                </div>
              )}
            </div>
          );
        }

        return (
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 sm:p-8">
            <label class="block text-gray-800 mb-4" for={fieldId}>
              {q.label} {q.required && <span class="text-red-600">*</span>}
            </label>
            <input
              id={fieldId}
              name={q.label}
              type={q.type === 'email' ? 'email' : 'text'}
              required={q.required}
              placeholder={q.placeholder || 'Tu respuesta'}
              class="w-full border-b border-gray-300 focus:border-brand outline-none py-2 text-gray-700 bg-transparent"
            />
          </div>
        );
      })}

      {meta?.acceptingResponses && (
        <>
          <p class="text-xs text-gray-500 px-2">
            Se enviará un correo electrónico con una copia de tus respuestas a la dirección que
            suministraste.
          </p>

          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 sm:p-8">
            <label class="flex items-start gap-3 cursor-pointer">
              <input
                id="consent-checkbox"
                type="checkbox"
                required
                class="mt-1 w-5 h-5 accent-brand shrink-0"
              />
              <span class="text-gray-800 text-sm">
                Entiendo que al enviar este formulario mis datos serán usados única y
                exclusivamente para el registro al Speaking Club, según la <a href="/politica-privacidad" target="_blank" class="text-brand hover:underline">política de privacidad</a>. <span class="text-red-600">*</span>
              </span>
            </label>
          </div>

          <p id="form-error" class="hidden text-red-600 text-sm px-2"></p>

          <div class="flex items-center justify-between px-2">
            <button
              type="submit"
              class="bg-brand hover:bg-indigo-600 text-white font-medium rounded-md px-6 py-2 transition-colors"
            >
              Enviar
            </button>
          </div>
        </>
      )}
    </form>

    <div id="registration-success" class="hidden max-w-[700px] mx-auto">
      <div class="bg-white rounded-lg shadow-sm border-t-8 border-brand p-8 text-center">
        <p class="text-gray-800 text-lg">Tu respuesta ha sido registrada.</p>
      </div>
    </div>

    <Footer />
  </div>
</Layout>

<script>
  const form = document.getElementById('registration-form') as HTMLFormElement;
  const errorNote = document.getElementById('form-error') as HTMLParagraphElement;
  const successBox = document.getElementById('registration-success') as HTMLDivElement;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorNote?.classList.add('hidden');

    const formData = new FormData(form);
    const answers: Record<string, string> = {};
    for (const [key, value] of formData.entries()) {
      answers[key] = String(value);
    }

    const consentCheckbox = document.getElementById('consent-checkbox') as HTMLInputElement | null;
    const consent = consentCheckbox?.checked ?? false;

    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitButton.disabled = true;

    try {
      const res = await fetch('/api/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ answers, consent }),
      });

      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        if (errorNote) {
          errorNote.textContent = data.error || 'Ocurrió un error al enviar el formulario.';
          errorNote.classList.remove('hidden');
        }
        submitButton.disabled = false;
        return;
      }

      form.classList.add('hidden');
      successBox.classList.remove('hidden');
    } catch {
      if (errorNote) {
        errorNote.textContent = 'No se pudo conectar con el servidor. Intenta de nuevo.';
        errorNote.classList.remove('hidden');
      }
      submitButton.disabled = false;
    }
  });
</script>
