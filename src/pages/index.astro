---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import logoBanner from '../images/logo.png';
import { db } from '../db/client';
import { forms } from '../db/schema';

export const prerender = false;

const formList = await db.select().from(forms).orderBy(forms.id);
---

<Layout titulo="CI-UNA - Centro de Idiomas">
  <div class="min-h-screen bg-[#f0ead6] py-8 px-4 flex flex-col">
    <div class="max-w-[700px] mx-auto w-full flex-1 space-y-4">
      <div class="rounded-lg overflow-hidden">
        <Image src={logoBanner} alt="Centro de Idiomas - Universidad Nacional" class="w-full h-auto" />
      </div>

      <div class="bg-white rounded-lg shadow-sm border-t-8 border-brand overflow-hidden p-6 sm:p-8">
        <h1 class="text-2xl text-gray-800 font-normal mb-2">Bienvenido</h1>
        <p class="text-sm text-gray-700 leading-relaxed">
          Elige a cuál formulario deseas ingresar.
        </p>
      </div>

      <div class="space-y-3">
        {formList.map((form) => (
          <a
            href={`/${form.slug}`}
            class="block bg-white rounded-lg shadow-sm border border-gray-200 p-6 sm:p-8 hover:border-brand transition-colors"
          >
            <h2 class="text-xl text-gray-800 font-semibold">{form.name}</h2>
            <p class="text-sm text-gray-500 mt-1">Ir al formulario de inscripción →</p>
          </a>
        ))}
      </div>
    </div>
    <Footer />
  </div>
</Layout>
