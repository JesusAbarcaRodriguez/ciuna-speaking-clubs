# Cadena de conexión de Supabase (Project Settings > Database > Connection string).
# Usa el "Transaction pooler" (puerto 6543) para entornos serverless como Vercel.
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Contraseña compartida para entrar a /admin
ADMIN_PASSWORD=cambia-esto

# Clave para firmar la cookie de sesión del admin (cualquier string largo y aleatorio)
SESSION_SECRET=cambia-esto-tambien
